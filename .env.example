# Optional ai& / OpenAI-compatible primary inference provider.
# Use the exact base URL and model name supplied by your provider or hackathon organizer.
# The app runs transparently in deterministic local mode when these are blank.
AIAND_API_KEY=
AIAND_BASE_URL=
AIAND_MODEL=
AIAND_TIMEOUT_SECONDS=45

# Optional independent OpenAI-compatible backup provider.
BACKUP_API_KEY=
BACKUP_BASE_URL=
BACKUP_MODEL=

# Defaults to backend/data/memora.db when unset.
MEMORA_DB_PATH=backend/data/memora.db

# Frontend requests use the Vite proxy by default.
VITE_API_URL=/api
